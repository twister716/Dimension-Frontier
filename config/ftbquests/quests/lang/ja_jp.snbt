	file.0000000000000001.title: "&z&lDimension Frontier"
	quest.4740DA1DEDAE1CB0.quest_desc: [
		"重い頭を上げながら眼を開けると、そこは見知らぬ土地だった。"
		"ああ、実験は良くも悪くも成功した。そう思った。"
		""
		"私はとある連邦政府直属の科学者だ。"
		"西暦&k2100&r年、全世界は統合され、一つの目標に対して協力していた。"
		"...それは、「&zタイムマシン&r」だ。"
		""
		"第&k四&r次世界大戦...全人類の八割を奪った大厄災。"
		"起きてしまったことはもう取り返せない。それが常識。"
		""
		"ただ...もし『&b過去に戻れる&r』としたら？"
		"過去に戻って、戦争を止められるとしたら？"
		""
		"...失われたものを全て取り戻せるとしたら？"
		""
		"{@pagebreak}"
		"そんな思いを胸に日々研究に打ち込んでいた。"
		""
		"ある日、とあるクリスタルが見つかった。"
		"「&aタイムクリスタル&r」"
		"そう名付けられた結晶は時空と時流を操る不思議な欠片のようだった。"
		""
		"早速我々科学者はそのクリスタルの研究を始めた。"
		""
		"そうしてついに、時空を超える力の解明に成功した。"
		""
		"それからタイムマシンの設計を進めていたある日"
		"いきなりタイムクリスタルが光りだし、研究室に時空の裂け目が出来始めた。"
		""
		"その時、研究室内に居たのは私一人だけだった。"
		""
		"「助けて」"
		"そんな声も虚しく、私は時空の裂け目に吸い込まれ、目が覚めたらここに居たというわけだ。"
		""
		"{@pagebreak}"
		"恐らくだが、ここは遥か遠い未来の世界だろう。"
		"どうやら、長い年月をかけることでだいぶ自然も復活したらしい。"
		""
		"だが、私は現代にやり残したことがある。"
		"妻や子供もいる。"
		""
		"ここが同じ世界なら、「&aタイムクリスタル&r」も必ず存在する。"
		""
		""
		"&d&lタイムクリスタルを使いこなし、必ず現代に戻ってみせる。&r"
	]
	quest.6FC32012735C3DEE.quest_desc: [
		"この遥か遠い未来の世界にたった独り。"
		"時流の力を操り、現代に戻ろう。"
		""
		"そんなテーマのModpack、【&zDimension Frontier&r】へようこそ！"
		"工業系Mod大好きな日本人が贈る、ストーリー付きの工業系Modpackです。"
		""
		"様々なディメンションを巡り、資源を『Void Mining』し、未来に帰るための機械を作るのが目標です。"
		""
		"{@pagebreak}"
		"《&aあらすじと説明&r》タブではパックの説明と生き抜くためのヒント"
		"《&a冒険と成長の記録&r》タブではメインストーリーを含む進行と導線"
		"《&a攻略の記録&r》タブでは各Modの詳しい進行"
		"《&a天上の取引場&r》タブではコインとの取引場所"
		"などが設けられています。"
	]
	quest.6FC32012735C3DEE.quest_subtitle: "マルチプレイだと独りじゃないかもしれない"
	task.58C1A30C51AE9122.title: "あらすじ"
}
